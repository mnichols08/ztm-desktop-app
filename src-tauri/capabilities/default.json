{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-load-courses",
    "allow-sync-courses",
    "allow-load-state",
    "allow-save-state",
    "allow-show-web-view",
    "allow-set-web-view-bounds",
    "allow-hide-web-view",
    "allow-dispose-web-view",
    "allow-open-course-window",
    "allow-sign-out",
    "allow-set-web-view-theme",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "discord://*" }]
    }
  ]
}
